-- Addition and subtraction
MathService.SafeAdd = function(value, add, maxValue)
	if (value + add) > maxValue then
		return maxValue
	else
		return value + add
	end
end

MathService.SafeSubtract = function(value, sub, minValue)
	if (value - sub) < minValue then
		return minValue
	else
		return value - sub
	end
end

return MathService
