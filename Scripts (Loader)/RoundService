local module = {}

-- Module definitions
module.CancelState = false
module.RoundStateMachine = nil
module.CurrentState = nil

-- Local definitions
local GUI = PlayerGUI.GUI
local RoundDisplay = GUI.UILabel2
local TimerDisplay = GUI.UILabel4
local MinPlayers = 2
-- Wait times for all the different states.
local WaitTimes = { 9, 3, 120, 5 }
local TaggerAmount = 1

local function Timer(time)
	TimerDisplay.Text = time
	for i = 1, time do
		wait(1)
		TimerDisplay.Text = time - i
	end
end

local function CancelableTimer(time)
	TimerDisplay.Text = time
	for i = 1, time do
		if module.CancelState then
			module.CancelState = false
			print("Wait cancelled")
			return true -- cancelled
		end
		wait(1)
		TimerDisplay.Text = time - i
	end
	return false -- ended normally
end

module.OnLoad = function(Services)
	spawn(function() -- No indentation here because this script is making me go insane.
