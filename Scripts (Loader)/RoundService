		-- Yes I know this is bad practice, but if I move the change-state stuff into a different function
		-- then it breaks the entire game and I genuinely have no idea how to solve it.
		for i, State in module.RoundStateMachine.ValidStates do
			if State == "Round" then
				module.RoundStateMachine.AfterEnter[State]["Wait"] = function()
					spawn(function()
						print("Waiting", WaitTimes[i], "for", State)
						CancelableTimer(WaitTimes[i])
						local j = i + 1
						if i == #module.RoundStateMachine.ValidStates then
							j = 1
						end
						print("Moving onto the state", module.RoundStateMachine.ValidStates[j])
						module.CurrentState = module.RoundStateMachine.ValidStates[j]
						module.RoundStateMachine:ChangeState(module.RoundStateMachine.ValidStates[j])
					end)
				end
			else
				module.RoundStateMachine.AfterEnter[State]["Wait"] = function()
					spawn(function()
						print("Waiting", WaitTimes[i], "for", State)
						Timer(WaitTimes[i])
						local j = i + 1
						if i == #module.RoundStateMachine.ValidStates then
							j = 1
						end
						print("Moving onto the state", module.RoundStateMachine.ValidStates[j])
						module.CurrentState = module.RoundStateMachine.ValidStates[j]
						module.RoundStateMachine:ChangeState(module.RoundStateMachine.ValidStates[j])
					end)
				end
			end
		end

		module.RoundStateMachine.AfterEnter["Intermission"]["CheckPlayers"] = function()
			print("Checking players before leaving intermission..")
			if Players.PlayersCount >= MinPlayers then
				print("Look good, moving on.")
				return
			end
			print("NOT good.")
			TimerDisplay.Text = "Waiting for players to start"
			repeat
				wait(1)
			until Players.PlayersCount >= MinPlayers
			-- Just lower MinPlayers if you need to work around this.
		end

		module.RoundStateMachine.BeforeEnter["Preparation"]["Deal Teams"] = function()
			print("Dealing out teams.")
			local Taggers = {}
			local Runners = {}
			local UsedIndexes = {}
			local Players = Players:GetChildren()

			for i = 1, TaggerAmount do
				local RandomPlayerIndex
				repeat
					RandomPlayerIndex = math.random(1, #Players)
				until not table.find(UsedIndexes, RandomPlayerIndex)
				table.insert(UsedIndexes, RandomPlayerIndex)

				table.insert(Taggers, Players[RandomPlayerIndex])
			end

			for i, Player in Players do
				if table.find(UsedIndexes, i) then
					continue
				end
				table.insert(Runners, Player)
			end

			-- I know that this is kinda overkill but it works nicely.
			Services["TeamService"].AssignTeams(Taggers, { Teams["Taggers"] }, { Environment.Map.TaggerSpawn }, true)
			Services["TeamService"].AssignTeams(Runners, { Teams["Runners"] }, { Environment.Map.RunnerSpawn }, true)
		end

		-- I really have no idea what to call this lol.
		module.RoundStateMachine.AfterEnter["Round End"]["Lobbify"] = function()
			Services["TeamService"].AssignTeams(
				Players:GetChildren(),
				{ Teams["Lobby Team"] },
				{ Environment.Lobby.Spawn },
				true
			)
		end

		module.RoundStateMachine:ChangeState("Intermission")
	end) -- Scary no indentation again jumpscare :O
end

return module

